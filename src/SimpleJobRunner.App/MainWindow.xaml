<Window x:Class="SimpleJobRunner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Simple Job Runner"
        Height="780"
        MinHeight="640"
        Width="1160"
        MinWidth="940"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Open outputs folder"
                        Command="{Binding OpenOutputsFolderCommand}"
                        ToolTip="Open the final user-visible output folder. If a job has completed, this opens that job's output folder; otherwise it opens the configured default output folder." />
                <Button Content="Settings"
                        Command="{Binding SettingsCommand}"
                        ToolTip="Configure the optional OpenAI API key for voice transcription, choose how Codex authenticates, set the output folder, and control retention/debug options." />
                <Button Content="About / Safety"
                        Command="{Binding ShowSafetyInfoCommand}"
                        Margin="0"
                        ToolTip="Explain what Simple Job Runner is, what it is not, and when not to use it for sensitive or regulated data." />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Simple Job Runner" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SetupMessage}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                BorderBrush="#D6DAE0"
                BorderThickness="1"
                Background="#F7F9FB"
                Padding="10"
                Margin="0,0,0,12"
                Visibility="{Binding SetupBannerVisibility}">
            <TextBlock Text="{Binding SetupMessage}" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Input files" Grid.Column="0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
                        <Button Content="Add files"
                                Command="{Binding AddFilesCommand}"
                                ToolTip="Select one or more files. Simple Job Runner copies them into the disposable run inbox before Codex sees them; originals are not edited." />
                        <Button Content="Add folder"
                                Command="{Binding AddFolderCommand}"
                                ToolTip="Select a folder. Simple Job Runner copies the folder contents into the disposable run inbox before Codex sees them; originals are not edited." />
                        <Button Content="Clear"
                                Command="{Binding ClearInputsCommand}"
                                Margin="0"
                                ToolTip="Remove selected input paths from this job setup. This does not delete any original files." />
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Inputs}" BorderBrush="#CED4DA">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Content="{Binding RecordButtonText}"
                                Command="{Binding RecordCommand}"
                                IsEnabled="{Binding CanStartRecording}"
                                ToolTip="{Binding RecordButtonToolTip}" />
                        <Button Content="Stop"
                                Command="{Binding StopRecordingCommand}"
                                IsEnabled="{Binding IsRecording}"
                                ToolTip="Stop microphone recording, send the temporary WAV file to OpenAI speech-to-text, insert the transcript into the prompt box, and delete the audio file." />
                        <Button Content="Run Simple Job"
                                Command="{Binding RunJobCommand}"
                                IsEnabled="{Binding CanRunJob}"
                                Background="{StaticResource AccentBrush}"
                                Foreground="White"
                                ToolTip="Run Codex CLI in a fresh disposable workspace. Text Query mode uses a read-only sandbox; file, external, and sensitive modes use workspace-write so requested outputs can be created." />
                        <Button Content="Safe test"
                                Command="{Binding SafeTestPromptCommand}"
                                ToolTip="Fill the prompt with a safe Text Query smoke test that should return text and create no files." />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="Mode" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource MutedBrush}" />
                        <ComboBox ItemsSource="{Binding TaskModes}"
                                  SelectedItem="{Binding SelectedTaskMode}"
                                  Width="170"
                                  Margin="0,0,8,0"
                                  ToolTip="Task mode controls sandboxing and confirmation. Text Query returns direct answers without files. File Job creates outputs. External Action and Admin / Sensitive require confirmation before running." />
                        <Button Content="Auto"
                                Command="{Binding AutoModeCommand}"
                                ToolTip="Re-detect the mode from the visible prompt text." />
                        <TextBlock Text="{Binding ModeStatusText}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedBrush}" />
                        <Button Content="Forget this job"
                                Command="{Binding ForgetJobCommand}"
                                Margin="0"
                                ToolTip="Delete the disposable run folder for the current job. Final copied outputs stay in the output folder unless you delete them yourself." />
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1"
                        BorderBrush="#D6DAE0"
                        BorderThickness="1"
                        Background="#F7F9FB"
                        Padding="8"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0">
                            <TextBlock Text="Prompt" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Expand editor"
                                        Command="{Binding ExpandPromptCommand}"
                                        ToolTip="Show a taller prompt editor for long dictated or pasted instructions. The text shown here is only your instruction, not the hidden Simple Job runner instructions." />
                                <Button Content="Collapse prompt"
                                        Command="{Binding CollapsePromptCommand}"
                                        Margin="0"
                                        ToolTip="Hide the prompt editor so the result tabs have more room. Runs automatically collapse the prompt when they start." />
                            </StackPanel>
                        </DockPanel>
                        <TextBox Grid.Row="1"
                                 Text="{Binding PromptText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 Height="{Binding PromptEditorHeight}"
                                 Visibility="{Binding PromptEditorVisibility}"
                                 ToolTip="Type or edit only the task you want done. The app adds its internal safety instructions separately, so those are not shown in this box." />
                    </Grid>
                </Border>

                <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />

                <TabControl Grid.Row="3"
                            SelectedIndex="{Binding SelectedResultTabIndex, Mode=OneWay}">
                    <TabItem Header="Text Result">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Copy text"
                                        Command="{Binding CopyTextCommand}"
                                        ToolTip="Copy the current text result to the clipboard." />
                                <Button Content="Save text as .txt"
                                        Command="{Binding SaveTextAsTxtCommand}"
                                        ToolTip="Save the current text result to a text file at a location you choose." />
                                <Button Content="Save text as .md"
                                        Command="{Binding SaveTextAsMdCommand}"
                                        ToolTip="Save the current text result to a Markdown file at a location you choose." />
                                <Button Content="Clear result"
                                        Command="{Binding ClearResultCommand}"
                                        Margin="0"
                                        ToolTip="Clear the displayed text, file list, and progress for this completed run. It does not delete saved output files." />
                            </StackPanel>
                            <TextBox Grid.Row="1"
                                     Text="{Binding TextResult}"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     ToolTip="The final useful answer captured from Codex summary.md. A successful job can have this text result even when no output files were generated." />
                        </Grid>
                    </TabItem>

                    <TabItem Header="Files">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListBox Grid.Row="0" ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,4">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding FinalPath}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Grid.Row="0"
                                       Text="No generated files for this run."
                                       Visibility="{Binding EmptyFilesVisibility}"
                                       Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Open file"
                                        Command="{Binding OpenSelectedOutputCommand}"
                                        ToolTip="Open the selected final output file with the Windows default app." />
                                <Button Content="Open outputs folder"
                                        Command="{Binding OpenOutputsFolderCommand}"
                                        Margin="0"
                                        ToolTip="Open the folder containing final copied outputs for the current job, or the configured output root if no job has completed." />
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Progress">
                        <Grid Margin="8">
                            <ListBox ItemsSource="{Binding ProgressItems}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Foreground="{StaticResource MutedBrush}" Width="72" />
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Details">
                        <Grid Margin="8">
                            <TextBox Text="{Binding DetailsText}"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     ToolTip="Structured run details, including result type, command summary, warnings, assumptions, files not processed, and output files." />
                        </Grid>
                    </TabItem>

                    <TabItem Header="Diagnostics">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Copy diagnostics"
                                        Command="{Binding CopyDiagnosticsCommand}"
                                        ToolTip="Copy the sanitized diagnostics text shown below. Secrets and known token patterns are redacted." />
                                <Button Content="Export diagnostics bundle"
                                        Command="{Binding ExportDiagnosticsCommand}"
                                        Margin="0"
                                        ToolTip="Save a sanitized diagnostics zip with run metadata, progress, summary, and diagnostics logs. Inputs and outputs are not included." />
                            </StackPanel>
                            <TextBox Grid.Row="1"
                                     Text="{Binding DiagnosticsText}"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     ToolTip="Sanitized diagnostic information for technical troubleshooting. Do not include input files or outputs unless you intentionally share them separately." />
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <ProgressBar Grid.Row="3"
                     Height="4"
                     Margin="0,12,0,0"
                     IsIndeterminate="{Binding IsBusy}"
                     Visibility="{Binding BusyVisibility}" />
    </Grid>
</Window>
