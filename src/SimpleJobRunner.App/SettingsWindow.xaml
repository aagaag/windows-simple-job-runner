<Window x:Class="SimpleJobRunner.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple Job Runner Settings"
        Height="590"
        Width="660"
        MinWidth="560"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="OpenAI API key" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding MaskedApiKey}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8" />
                <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_PasswordChanged" Margin="0,4,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Button Content="Set / Replace key" Command="{Binding SaveKeyCommand}" />
                    <Button Content="Test key" Command="{Binding TestKeyCommand}" />
                    <Button Content="Delete key" Command="{Binding DeleteKeyCommand}" Margin="0" />
                </StackPanel>

                <TextBlock Text="Speech model" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding SpeechModels}" SelectedItem="{Binding SelectedSpeechModel}" />

                <TextBlock Text="Codex authentication" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding CodexAuthModes}" SelectedItem="{Binding SelectedCodexAuthMode}" />

                <TextBlock Text="Output folder" FontWeight="SemiBold" />
                <DockPanel Margin="0,4,0,8">
                    <Button DockPanel.Dock="Right" Content="Browse" Command="{Binding BrowseOutputFolderCommand}" Margin="8,0,0,0" />
                    <TextBox Text="{Binding OutputRoot, UpdateSourceTrigger=PropertyChanged}" Margin="0" />
                </DockPanel>

                <TextBlock Text="Retention" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                    <TextBox Width="80" Text="{Binding RunRetentionDays, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="days to keep run folders by default" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

                <CheckBox Content="Keep transcript files in run folders" IsChecked="{Binding RetainTranscripts}" Margin="0,0,0,8" />
                <CheckBox Content="Keep Codex JSONL debug logs" IsChecked="{Binding DebugLogging}" Margin="0,0,0,8" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" />
            <Button Content="Close" Command="{Binding CloseCommand}" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
